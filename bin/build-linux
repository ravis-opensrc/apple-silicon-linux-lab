#!/bin/bash
set -euo pipefail
source "$(cd "$(dirname "$0")/.." && pwd)/scripts/common.sh"
if [[ ${1:-} == --help ]]; then
  echo 'Usage: build-linux [current|GIT_REF] [--debug|--gdb]'
  exit
fi
ref= debug_cfg=${LINUX_DEBUG_CONFIG:-0}
for arg in "$@"; do
  case "$arg" in
    --debug|--gdb) debug_cfg=1 ;;
    --*) die "Unknown option: $arg" ;;
    *) [[ -z $ref ]] || die 'Only one Git ref may be supplied.'; ref=$arg ;;
  esac
done
ref=${ref:-current}
require_tool container
resolve_build "$ref"
python3 "$LAB_DIR/scripts/lab-state.py" validate-snapshots "$LAB_SOURCE" "$LAB_SNAPSHOT_DIR"
acquire_lock "$LAB_STATE/build.lock" 'A setup or build is already running'
install_lifecycle "$LAB_STATE/build.lock"
run="$(date -u +%Y%m%dT%H%M%SZ)-$$"
LAB_ARTIFACTS="$LAB_GROUP/runs/$run"
LAB_BUILD_SOURCE="$LAB_SNAPSHOT_DIR/$LAB_KEY-$run"
mkdir -p "$LAB_ARTIFACTS" "$LAB_BUILD_SOURCE"
python3 "$LAB_DIR/scripts/lab-state.py" stage "$LAB_DIR" "$LAB_ARTIFACTS" "$LAB_CONFIG_FRAGMENTS_JSON" "$debug_cfg"
container system start
container image inspect "$LAB_IMAGE" >/dev/null || die 'Run setup-linux-lab first.'
if [[ $LAB_MODE == ref ]]; then
  git -C "$LAB_SOURCE" archive --format=tar "$LAB_COMMIT" > "$LAB_ARTIFACTS/source.tar"
  : > "$LAB_ARTIFACTS/source-status"
else
  git -C "$LAB_SOURCE" status --porcelain > "$LAB_ARTIFACTS/source-status"
fi
printf '%s\n' "$LAB_COMMIT" > "$LAB_ARTIFACTS/commit"
echo "Building $ref ($LAB_COMMIT), arm64, $LAB_JOBS jobs (debug=$debug_cfg)"
name="linux-lab-build-$$"
run_owned python3 "$LAB_DIR/scripts/run-command.py" --log "$LAB_ARTIFACTS/build.log" --container-name "$name" -- \
  container run --rm --name "$name" --cpus "$LAB_JOBS" --memory "$LAB_MEMORY" --entrypoint /bin/bash \
  -v "$LAB_VOLUME:/work" \
  --mount "type=bind,source=$LAB_DIR,target=/lab,readonly" \
  --mount "type=bind,source=$LAB_SOURCE,target=/checkout,readonly" \
  -v "$LAB_ARTIFACTS:/artifacts" "$LAB_IMAGE" \
  -c 'cp /lab/scripts/container-build.sh /tmp/linux-lab-build.sh; exec /bin/bash /tmp/linux-lab-build.sh "$@"' \
  linux-lab-build "$LAB_KEY" "$LAB_MODE" "$LAB_JOBS" "$debug_cfg" \
  "$LAB_LOCALVERSION" "$LAB_KBUILD_USER" "$LAB_KBUILD_HOST" \
  "$LAB_OPTIONAL_KCONFIGS" "$LAB_REQUIRED_KCONFIGS"
# The source checkout is already on a case-sensitive filesystem. Keep snapshots
# beside it so case-distinct Linux headers survive export to macOS.
tar -xf "$LAB_ARTIFACTS/source.tar" -C "$LAB_BUILD_SOURCE"
rm "$LAB_ARTIFACTS/source.tar"
python3 "$LAB_DIR/scripts/lab-state.py" publish "$LAB_STATE" "$LAB_ARTIFACTS" "$LAB_KEY" "$LAB_COMMIT" "$LAB_BUILD_SOURCE" "$debug_cfg"
echo "Artifacts: $LAB_ARTIFACTS"
echo "Launch: launch-linux $ref"
