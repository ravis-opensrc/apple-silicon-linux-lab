#!/bin/bash
set -euo pipefail
source "$(cd "$(dirname "$0")/.." && pwd)/scripts/common.sh"
require_tool container
acquire_lock "$LAB_STATE/build.lock" "A setup or build already holds the work volume"
install_lifecycle "$LAB_STATE/build.lock"
container system start
mkdir -p "$LAB_STATE/ssh"
chmod 700 "$LAB_STATE/ssh"
if [[ ! -f "$LAB_STATE/ssh/id_ed25519" ]]; then
  ssh-keygen -q -t ed25519 -N '' -C linux-lab-local -f "$LAB_STATE/ssh/id_ed25519"
fi
if ! container image inspect "$LAB_IMAGE" >/dev/null 2>&1; then
  bootstrap="linux-lab-bootstrap-$$"
  run_owned python3 "$LAB_DIR/scripts/run-command.py" --container-name "$bootstrap" -- container run --name "$bootstrap" --cpus 4 --memory 4G --entrypoint /bin/bash \
    --mount "type=bind,source=$LAB_DIR,target=/lab,readonly" \
    debian:trixie-slim /lab/scripts/provision-builder.sh
  container commit "$bootstrap" "$LAB_IMAGE"
  container rm "$bootstrap"
fi
if ! container volume inspect "$LAB_VOLUME" >/dev/null 2>&1; then
  container volume create -s 64G "$LAB_VOLUME"
fi
if [[ ! -f "$LAB_STATE/$LAB_ROOTFS_NAME" ]]; then
  rootfs_container="linux-lab-rootfs-$$"
  run_owned python3 "$LAB_DIR/scripts/run-command.py" --container-name "$rootfs_container" -- container run --rm --name "$rootfs_container" --cpus 2 --memory 2G --entrypoint /bin/bash \
    -v "$LAB_VOLUME:/work" \
    --mount "type=bind,source=$LAB_DIR,target=/lab,readonly" \
    -v "$LAB_STATE:/artifacts" "$LAB_IMAGE" /lab/scripts/prepare-rootfs.sh "$LAB_ROOTFS_NAME"
fi
echo "Ready. Run build-linux, then launch-linux."
