#!/bin/bash
set -euo pipefail
source "$(cd "$(dirname "$0")/.." && pwd)/scripts/common.sh"
if [[ ${1:-} == --ssh ]]; then
  shift
  [[ -f "$LAB_STATE/ssh/config" ]] || die 'Start a guest with launch-linux first.'
  exec ssh -F "$LAB_STATE/ssh/config" linux-lab "$@"
fi
if [[ ${1:-} == --attach-gdb ]]; then
  shift
  expected_key=""
  if [[ -n ${1:-} ]]; then resolve_build "$1"; expected_key=$LAB_KEY; fi
  settings=$(python3 "$LAB_DIR/scripts/lab-state.py" active "$LAB_STATE") || die 'No running guest with a GDB stub.'
  eval "$settings"
  [[ -z $expected_key || $expected_key == "$LAB_KEY" ]] || die 'That ref is not the running guest.'
  [[ -s "$LAB_ARTIFACTS/vmlinux" ]] || die 'The running guest has no debug symbols; rebuild with --debug.'
  mapping=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1])+" "+json.dumps(sys.argv[2]))' "$LAB_CONTAINER_SOURCE" "$LAB_BUILD_SOURCE")
  if command -v aarch64-elf-gdb >/dev/null 2>&1; then
    exec aarch64-elf-gdb "$LAB_ARTIFACTS/vmlinux" \
      -ex "set substitute-path $mapping" -ex "target remote 127.0.0.1:$LAB_ACTIVE_GDB_PORT"
  elif command -v lldb >/dev/null 2>&1; then
    exec lldb "$LAB_ARTIFACTS/vmlinux" \
      -o "settings set target.source-map $mapping" -o "gdb-remote 127.0.0.1:$LAB_ACTIVE_GDB_PORT"
  else
    die 'Install aarch64-elf-gdb or Xcode Command Line Tools (lldb).'
  fi
fi
if [[ ${1:-} == --help ]]; then
  echo 'Usage: launch-linux [current|GIT_REF] [--smoke] [--gdb|--gdb-wait]'
  echo '       launch-linux --ssh [SSH_COMMAND...]  # connect to the running guest'
  echo '       launch-linux --attach-gdb [GIT_REF]  # attach aarch64-elf-gdb or lldb to gdbstub'
  echo 'Without a ref, boots the most recently successful build. --smoke boots, runs checks, powers off.'
  echo '  --gdb       Open QEMU gdbstub on 127.0.0.1:<gdb_port> with nokaslr.'
  echo '  --gdb-wait  Same as --gdb, but pause CPU at reset until debugger attaches.'
  exit
fi
ref= smoke=0 gdb=0 gdb_wait=0
for arg in "$@"; do
  case "$arg" in
    --smoke) smoke=1 ;;
    --gdb) gdb=1 ;;
    --gdb-wait) gdb=1; gdb_wait=1 ;;
    --*) die "Unknown option: $arg" ;;
    *) [[ -z $ref ]] || die 'Only one Git ref may be supplied.'; ref=$arg ;;
  esac
done
require_tool qemu-system-aarch64
require_tool qemu-img
if [[ -n $ref ]]; then
  resolve_build "$ref"
  select_artifacts "$LAB_KEY"
else
  select_artifacts
fi
[[ -s "$LAB_ARTIFACTS/Image" ]] || die 'No kernel found for this ref; run build-linux for it first.'
[[ -s "$LAB_STATE/$LAB_ROOTFS_NAME" ]] || die 'Run setup-linux-lab first.'
acquire_lock "$LAB_STATE/guest.lock" "Guest already running"
install_lifecycle "$LAB_STATE/guest.lock"

rootfs_base="${LAB_ROOTFS_NAME%.raw}"
disk="$LAB_STATE/builds/$LAB_KEY/${rootfs_base}.qcow2"
if [[ ! -f $disk ]]; then
  qemu-img create -f qcow2 -F raw -b "$LAB_STATE/$LAB_ROOTFS_NAME" "$disk"
  if [[ -f "$LAB_STATE/ssh/known_hosts" ]]; then
    ssh-keygen -R "linux-lab-$LAB_KEY" -f "$LAB_STATE/ssh/known_hosts" >/dev/null 2>&1 || true
  fi
fi

accel=$LAB_VM_ACCEL
cpu=host
[[ $accel != tcg ]] || cpu=max
cmdline="root=/dev/vda rw rootwait console=ttyAMA0 init=/sbin/lab-init panic=-1 kunit.enable=1 kunit.autorun=1 lab.hostname=$LAB_VM_HOSTNAME"
if [[ $smoke == 1 ]]; then
  cmdline="$cmdline lab.smoke=1"
  [[ -z "${LAB_SMOKE_CHECK_PATHS:-}" ]] || cmdline="$cmdline lab.smoke_paths=$LAB_SMOKE_CHECK_PATHS"
fi

gdb_args=()
if [[ $gdb == 1 ]]; then
  gdb_port=$LAB_GDB_PORT
  case "$gdb_port" in ''|*[!0-9]*) die 'gdb_port must be numeric.' ;; esac
  [[ $gdb_port -gt 0 && $gdb_port -le 65535 ]] || die 'gdb_port must be 1..65535.'
  cmdline="$cmdline nokaslr"
  gdb_args=(-gdb "tcp:127.0.0.1:$gdb_port")
  [[ $gdb_wait == 0 ]] || gdb_args+=(-S)
  echo "QEMU gdbstub listening on 127.0.0.1:$gdb_port (attach with: launch-linux --attach-gdb)"
  if [[ ! -s "$LAB_ARTIFACTS/vmlinux" ]]; then
    echo "Warning: $LAB_ARTIFACTS/vmlinux not found; rebuild with 'build-linux --debug' for symbols." >&2
  fi
fi

ssh_port=$LAB_SSH_PORT
case "$ssh_port" in ''|*[!0-9]*) die 'ssh_port must be numeric.' ;; esac
[[ $ssh_port -gt 0 && $ssh_port -le 65535 ]] || die 'ssh_port must be 1..65535.'
cat > "$LAB_STATE/ssh/config" <<CONFIG
Host linux-lab
    HostName 127.0.0.1
    Port $ssh_port
    User root
    IdentityFile "$LAB_STATE/ssh/id_ed25519"
    IdentitiesOnly yes
    UserKnownHostsFile "$LAB_STATE/ssh/known_hosts"
    HostKeyAlias linux-lab-$LAB_KEY
    StrictHostKeyChecking accept-new
CONFIG
echo "SSH from another terminal: launch-linux --ssh (127.0.0.1:$ssh_port)"

[[ -d "$LAB_BUILD_SOURCE/kernel" ]] || die 'Matching source snapshot is missing; rebuild this ref.'
virtfs_args=(-virtfs "local,path=$LAB_BUILD_SOURCE,mount_tag=linuxsrc,security_model=none,readonly=on")
timeout_args=()
if [[ $smoke == 1 ]]; then
  case "$LAB_SMOKE_TIMEOUT" in ''|*[!0-9]*) die 'smoke_timeout must be a positive integer.' ;; esac
  [[ $LAB_SMOKE_TIMEOUT -gt 0 ]] || die 'smoke_timeout must be positive.'
  [[ $gdb_wait == 0 ]] || die '--smoke cannot be combined with --gdb-wait.'
  timeout_args=(--timeout "$LAB_SMOKE_TIMEOUT")
fi
run_owned python3 "$LAB_DIR/scripts/run-command.py" \
  --guest-state "$LAB_STATE/guest.json" --manifest "$LAB_ARTIFACTS/manifest.json" \
  --gdb-port "$([[ $gdb == 1 ]] && echo "$LAB_GDB_PORT" || echo 0)" --ssh-port "$ssh_port" \
  ${timeout_args[@]+"${timeout_args[@]}"} -- \
qemu-system-aarch64 -machine virt,gic-version=3 -accel "$accel" -cpu "$cpu" \
  -smp "$LAB_VM_CPUS" -m "$LAB_VM_MEMORY" \
  -kernel "$LAB_ARTIFACTS/Image" -append "$cmdline ${LAB_EXTRA_KERNEL_ARGS:-}" \
  -drive "file=$disk,if=virtio,format=qcow2" \
  ${virtfs_args[@]+"${virtfs_args[@]}"} \
  ${gdb_args[@]+"${gdb_args[@]}"} \
  -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:$ssh_port-:22" -device virtio-net-pci,netdev=net0 \
  -device virtio-rng-pci -display none -no-reboot \
  -chardev "stdio,id=console,mux=on,signal=off,logfile=$LAB_ARTIFACTS/boot.log" \
  -serial chardev:console -object monitor-hmp,id=monitor,chardev=console

if [[ $smoke == 1 ]]; then
  grep -q 'LINUX_LAB_SMOKE_STATUS=0' "$LAB_ARTIFACTS/boot.log" || die 'Guest smoke check failed; see boot.log.'
  if [[ -n "${LAB_SMOKE_KUNIT_PATTERN:-}" ]]; then
    grep -q "$LAB_SMOKE_KUNIT_PATTERN" "$LAB_ARTIFACTS/boot.log" || die "Expected KUnit pattern '$LAB_SMOKE_KUNIT_PATTERN' missing; see boot.log."
  fi
  if grep -Eq '(^|\])[[:space:]]*not ok [0-9]' "$LAB_ARTIFACTS/boot.log"; then
    die 'KUnit reported a failure; see boot.log.'
  fi
fi
